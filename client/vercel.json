{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://peptideweightloss.vercel.app/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}