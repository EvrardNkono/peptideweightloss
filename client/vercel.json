{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.peptidesweight-loss.com"
        }
      ],
      "destination": "https://peptidesweight-loss.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://peptideweightloss.vercel.app/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell"
    }
  ]
}